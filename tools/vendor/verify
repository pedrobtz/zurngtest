#!/bin/sh
# Verify that src/practrand/ is the pinned PractRand archive plus exactly the
# patch series in tools/patches/, byte for byte, and that src/Makevars builds
# every vendored source file. Exits non-zero on any difference. Run from the
# package root.
#
#   tools/vendor/verify            the gate
#   tools/vendor/verify --canary   the gate's canary: compare the derived tree
#                                  with a copy of src/practrand/ that has one
#                                  file changed, one removed and one added,
#                                  and run the patch-list, Makevars and
#                                  version gates on tampered copies; every
#                                  gate must report its failure. Failing to
#                                  derive the tree fails the canary too.
set -eu

CANARY=0
[ "${1:-}" = "--canary" ] && CANARY=1

PROV="src/practrand/PROVENANCE"
VERSION=$(awk '/^  Version:/ {print $2}' "$PROV")
echo "==> pinned PractRand $VERSION"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAILURES="$WORK/failures"
: > "$FAILURES"

if ! tools/vendor/derive "$WORK/tree" 2> "$WORK/derive.err"; then
  cat "$WORK/derive.err" >&2
  echo "==> could not derive the tree from the pinned archive and patches" >&2
  exit 1
fi

# compare <dir>: record every difference between the derived tree and <dir>.
# Build artefacts are ignored, since R builds in place, and so is PROVENANCE,
# which is not derived.
compare() {
  (cd "$WORK/tree" && find . -type f | sort) > "$WORK/derived"
  (cd "$1" && find . -type f ! -name PROVENANCE \
    ! -name '*.o' ! -name '*.so' ! -name '*.dll' ! -name '*.dylib' | sort) > "$WORK/local"
  comm -23 "$WORK/derived" "$WORK/local" |
    sed 's|^\./|FAIL: missing src/practrand/|' >> "$FAILURES"
  comm -13 "$WORK/derived" "$WORK/local" |
    sed 's|^\./|FAIL: not derived from upstream: src/practrand/|' >> "$FAILURES"
  while read -r f; do
    if [ -f "$1/$f" ] && ! cmp -s "$WORK/tree/$f" "$1/$f"; then
      echo "FAIL: src/practrand/${f#./} differs from upstream plus patches" >> "$FAILURES"
    fi
  done < "$WORK/derived"
}

# check_patches <patch-dir>: the patch series on disk must be exactly what
# PROVENANCE lists, in order.
check_patches() {
  awk '/^  Local patches:/ {on = 1; next} on && /^ +[^ ]+\.patch$/ {print $1; next} on {exit}' \
    "$PROV" > "$WORK/listed"
  ls "$1"/*.patch 2>/dev/null | xargs -n1 basename > "$WORK/present" || true
  cmp -s "$WORK/listed" "$WORK/present" ||
    echo "FAIL: tools/patches/ does not match the patch list in $PROV" >> "$FAILURES"
}

# check_makevars <makevars>: it must compile every vendored translation
# unit, and nothing else from the vendored tree.
check_makevars() {
  (cd "$WORK/tree" && find src -name '*.cpp' | sed 's|^|practrand/|; s|\.cpp$|.o|' | sort) > "$WORK/units"
  grep -o 'practrand/src/[^ \\]*\.o' "$1" | sort > "$WORK/listed-units"
  comm -23 "$WORK/units" "$WORK/listed-units" |
    sed 's|^|FAIL: src/Makevars does not build |' >> "$FAILURES"
  comm -13 "$WORK/units" "$WORK/listed-units" |
    sed 's|^|FAIL: src/Makevars builds a file that is not vendored: |' >> "$FAILURES"
}

# check_version <rand.cpp>: zurngtest_info() reports the version PractRand
# compiles in; it must be the version pinned here.
check_version() {
  grep -q "version_str = \"$VERSION\"" "$1" ||
    echo "FAIL: src/practrand/src/rand.cpp does not report version $VERSION" >> "$FAILURES"
}

# expect_reported <text>: the canary fails unless a gate reported <text>.
expect_reported() {
  if ! grep -q "$1" "$FAILURES"; then
    cat "$FAILURES" >&2
    echo "CANARY FAILED: no gate reported: $1" >&2
    exit 1
  fi
}

if [ "$CANARY" -eq 1 ]; then
  cp -R src/practrand "$WORK/local-copy"
  printf '\n' >> "$WORK/local-copy/src/math.cpp"
  rm "$WORK/local-copy/src/sha2.cpp"
  : > "$WORK/local-copy/src/canary.cpp"
  compare "$WORK/local-copy"
  expect_reported "differs from upstream plus patches"
  expect_reported "missing src/practrand/src/sha2.cpp"
  expect_reported "not derived from upstream: src/practrand/src/canary.cpp"

  # A patch on disk that PROVENANCE does not list.
  cp -R tools/patches "$WORK/patches-copy"
  : > "$WORK/patches-copy/9999-canary.patch"
  check_patches "$WORK/patches-copy"
  expect_reported "does not match the patch list"

  # A Makevars that drops one vendored unit and builds one that is not.
  sed 's|practrand/src/sha2\.o|practrand/src/canary.o|' src/Makevars > "$WORK/Makevars-copy"
  check_makevars "$WORK/Makevars-copy"
  expect_reported "does not build practrand/src/sha2.o"
  expect_reported "not vendored: practrand/src/canary.o"

  # A compiled-in version that is not the pinned one.
  sed "s|version_str = \"$VERSION\"|version_str = \"0.0\"|" \
    src/practrand/src/rand.cpp > "$WORK/rand-copy.cpp"
  check_version "$WORK/rand-copy.cpp"
  expect_reported "does not report version"

  echo "==> canary OK: every gate reported its failure"
  exit 0
fi

check_patches tools/patches
compare src/practrand
count=$(wc -l < "$WORK/derived" | tr -d ' ')
check_makevars src/Makevars
check_version src/practrand/src/rand.cpp

if [ -s "$FAILURES" ]; then
  cat "$FAILURES" >&2
  echo "==> vendor tree FAILED verification" >&2
  exit 1
fi
echo "==> vendor tree verified ($count files, PractRand $VERSION plus $(wc -l < "$WORK/present" | tr -d ' ') patches)"
